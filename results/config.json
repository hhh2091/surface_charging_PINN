{
  "model": {
    "vnn_input_dim": 12,
    "vnn_hidden_dims": [
      64,
      64,
      64,
      64
    ],
    "vnn_activation": "tanh",
    "yield_input_dim": 4,
    "yield_hidden_dims": [
      32,
      32,
      32
    ],
    "yield_activation": "relu"
  },
  "data": {
    "t_range": [
      0.0,
      10.0
    ],
    "x_range": [
      -0.1,
      0.1
    ],
    "y_range": [
      -0.1,
      0.1
    ],
    "z_range": [
      -0.01,
      0.01
    ],
    "ne_range": [
      1000000.0,
      100000000.0
    ],
    "Te_range": [
      1000,
      5000
    ],
    "ni_range": [
      1000000.0,
      100000000.0
    ],
    "Ti_range": [
      1000,
      5000
    ],
    "Sflux_range": [
      0.0,
      1361.0
    ],
    "alpha_sun_range": [
      0.0,
      1.5707963267948966
    ],
    "alpha_ram_range": [
      0.0,
      3.141592653589793
    ],
    "n_materials": 3,
    "n_collocation": 10000,
    "n_boundary": 1000,
    "n_initial": 1000,
    "n_data": 2000,
    "noise_level": 0.01,
    "sampling_method": "latin_hypercube"
  },
  "loss_weights": {
    "residual": 1.0,
    "boundary": 10.0,
    "initial": 10.0,
    "data": 1.0
  },
  "adaptive_weighting": {
    "method": "gradient_normalization",
    "alpha": 0.9
  },
  "use_adaptive_weighting": true,
  "optimizer": {
    "adam": {
      "lr": 0.001,
      "betas": [
        0.9,
        0.999
      ],
      "eps": 1e-08,
      "weight_decay": 1e-06,
      "max_iter": 5000
    },
    "lbfgs": {
      "lr": 1.0,
      "max_iter": 1000,
      "tolerance_grad": 1e-07,
      "tolerance_change": 1e-09,
      "history_size": 100,
      "line_search_fn": "strong_wolfe"
    }
  },
  "normalize_inputs": true,
  "normalize_outputs": true,
  "input_normalization": "minmax",
  "output_normalization": "zscore",
  "early_stopping": {
    "patience": 200,
    "min_delta": 1e-06,
    "restore_best_weights": true
  },
  "gradient_clipping": true,
  "max_grad_norm": 1.0,
  "save_dir": "./results"
}